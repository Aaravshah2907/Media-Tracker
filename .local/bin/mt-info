    local id="$1"
    local force="${2:-false}"
    local file="$CACHE_DIR/movie/tmdb_${id}.json"

    if [[ -s "$file" ]] && jq -e . "$file" > /dev/null 2>&1 && [[ "$force" != "true" ]]; then
        echo "Cache exists for movie $id, skipping."
        return
    fi

    local attempts=0
    local max_attempts=3
    while (( attempts < max_attempts )); do
        attempts=$((attempts + 1))
        local tmp_file="${file}.tmp"
        # Use curl with -f to fail on HTTP errors
        curl -s -f "https://api.themoviedb.org/3/movie/${id}?language=en-US" \
             -H "Authorization: Bearer $TMDB_TOKEN" \
             -H "accept: application/json" -o "$tmp_file"
        curl_exit=$?
        if [[ $curl_exit -ne 0 ]]; then
            echo "Attempt $attempts: HTTP request failed for movie $id (curl exit $curl_exit). Retrying..."
            rm -f "$tmp_file"
            sleep 1
            continue
        fi
        # Validate JSON content
        if jq -e . "$tmp_file" > /dev/null 2>&1; then
            mv "$tmp_file" "$file"
            echo "Saved movie $id to $file"
            return
        else
            echo "Attempt $attempts: Received invalid JSON for movie $id. Retrying..."
            rm -f "$tmp_file"
            sleep 1
        fi
    done
    echo "All attempts failed: Could not fetch valid data for movie $id."
    return 1
}
