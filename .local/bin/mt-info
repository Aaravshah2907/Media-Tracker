#!/usr/bin/env bash
# mt-info: Fetch media info for all library items and cache them
# Refreshes pending.json at the start every run

DATA_DIR="${DATA_DIR:-$HOME/Documents/Personal/Tracker}"
LIBRARY="$DATA_DIR/library.json"
CACHE_DIR="$DATA_DIR/cache"
PENDING="$CACHE_DIR/pending.json"

mkdir -p "$CACHE_DIR/anime" "$CACHE_DIR/manga" "$CACHE_DIR/tv" "$CACHE_DIR/movie" "$CACHE_DIR/book"

# -------------------------
# Load TMDB token from env
# -------------------------
ENV_FILE="$HOME/.config/mt/.env"
if [[ -f "$ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$ENV_FILE"
else
    echo "TMDB token file not found: $ENV_FILE"
    exit 1
fi

if [[ -z "$TMDB_TOKEN" ]]; then
    echo "TMDB_TOKEN is not set in $ENV_FILE"
    exit 1
fi

# -------------------------
# Functions to fetch data
# -------------------------

fetch_anilist() {
    local id="$1"
    local type="$2"
    local force="${3:-false}"
    local file="$CACHE_DIR/$type/anilist_${id}.json"

    if [[ -s "$file" ]] && jq -e . "$file" >/dev/null 2>&1 && [[ "$force" != "true" ]]; then
        echo "Cache exists for $type $id, skipping."
        return
    fi

    query='
    query ($id: Int) {
      Media(id: $id) {
        id
        title { romaji english native }
        type
        format
        status
        episodes
        chapters
        volumes
        genres
        description
        idMal
        startDate { year month day }
        endDate { year month day }
        averageScore
        popularity
        coverImage { large medium }
      }
    }'

    json=$(jq -n --argjson id "$id" --arg query "$query" '{query: $query, variables: {id: $id|tonumber}}')

    local tmp_file="${file}.tmp"
    curl -s -X POST "https://graphql.anilist.co" \
        -H "Content-Type: application/json" \
        -d "$json" | jq . > "$tmp_file"

    if [[ -s "$tmp_file" ]] && jq -e . "$tmp_file" >/dev/null 2>&1; then
        mv "$tmp_file" "$file"
        echo "Saved $type $id to $file"
    else
        echo "Failed to fetch/parse anilist $type $id."
        rm -f "$tmp_file"
        rm -f "$file"
        return 1
    fi
}

fetch_tv() {
    local id="$1"
    local force="${2:-false}"
    local file="$CACHE_DIR/tv/tvmaze_${id}.json"

    if [[ -s "$file" ]] && jq -e . "$file" >/dev/null 2>&1 && [[ "$force" != "true" ]]; then
        echo "Cache exists for tv $id, skipping."
        return
    fi

    local tmp_file="${file}.tmp"
    curl -s "https://api.tvmaze.com/shows/${id}?embed=episodes" | jq . > "$tmp_file"

    if [[ -s "$tmp_file" ]] && jq -e . "$tmp_file" >/dev/null 2>&1; then
        mv "$tmp_file" "$file"
        echo "Saved tv $id to $file"
    else
        echo "Failed to fetch/parse tv $id."
        rm -f "$tmp_file"
        rm -f "$file"
        return 1
    fi
}

